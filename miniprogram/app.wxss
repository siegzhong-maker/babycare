/** app.wxss **/
page {
  /* Morandi / Warm Palette */
  --brand-primary: #8FB2A3;      /* Sage Green - Calm, Trust */
  --brand-primary-light: #E8F3EE; 
  --brand-secondary: #FFCB9A;    /* Warm Apricot - Energy */
  --brand-blue: #A9CBD6;         /* Muted Blue - Sleep */
  --brand-pink: #F4C5C2;         /* Soft Pink - Care */
  
  --bg-page: #FDFBF7;            /* Creamy White - Warmth */
  --bg-white: #FFFFFF;
  
  --text-main: #4A4A4A;          /* Dark Grey - Soft Contrast */
  --text-secondary: #888888;
  
  --shadow-soft: 0 8rpx 30rpx rgba(143, 178, 163, 0.12);
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  
  --radius-card: 24rpx;
  --radius-btn: 44rpx;

  background-color: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', sans-serif;
  color: var(--text-main);
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
} 

/* Common Utility Classes */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
